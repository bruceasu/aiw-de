[Unit]
Description=AIW Process Worker role %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aiw
WorkingDirectory=/opt/aiw/process-typescript
Environment=AIW_AGENT_RUNTIME=codex-app-server
Environment=AIW_PROCESS_ROLE=%i
EnvironmentFile=/etc/aiw/process-worker.env
EnvironmentFile=-/etc/aiw/worker-%i.env
ExecStart=/usr/bin/node /opt/aiw/process-typescript/dist/index.js
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=infinity

[Install]
WantedBy=multi-user.target
