# Copy this file outside the repository. Load it with node --env-file.
# Set a unique ID for each manually started Worker.
AIW_CONTROL_PLANE_URL=http://127.0.0.1:8080
AIW_AGENT_RUNTIME=codex-app-server
AIW_PROCESS_ROLE=requirements
AIW_WORKER_ID=local-requirements-1
AIW_WORKER_MAX_CONCURRENCY=1
AIW_WORKER_TOKEN=
AIW_WORKER_CAPABILITIES=

# Set both values to use a registered Workspace.
# AIW_REPOSITORY_REF=test-project/root
# AIW_REPOSITORY_ROOT=/absolute/path/to/project

# Codex defaults. An empty model uses your CLI configuration.
AIW_CODEX_MODEL=
AIW_CODEX_REASONING_EFFORT=medium
AIW_CODEX_APPROVAL_POLICY=never
AIW_CODEX_SANDBOX=danger-full-access
# AIW_CODEX_PATH=/absolute/path/to/codex
# CODEX_HOME=/absolute/path/outside/project/.codex

# API runtime: set AIW_AGENT_RUNTIME=openai-agents and provide a key.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
AIW_OPENAI_MODEL=gpt-4.1
AIW_OPENAI_REASONING_EFFORT=

AIW_WORKER_POLL_MS=1000
AIW_WORKER_HEARTBEAT_MS=20000
AIW_WORKER_HTTP_TIMEOUT_MS=15000
AIW_WORKER_ATTEMPT_TIMEOUT_MS=900000
AIW_WORKER_ATTEMPT_HARD_TIMEOUT_MS=0
AIW_WORKER_CACHE_ROOT=/mnt/temp/cache
# AIW_WORKER_EVIDENCE_ROOT=/absolute/path/outside/project/attempt-evidence

# Manager only. Per-role capabilities replace AIW_WORKER_CAPABILITIES.
AIW_WORKER_ID_PREFIX=local-ts
AIW_WORKER_CAPABILITIES_CODER=typescript,node
AIW_WORKER_CAPABILITIES_STAGE_REVIEWER=typescript,node
