{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/software-engineering/engineering-artifact.schema.json",
  "title": "Engineering Artifact Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "type",
    "projectId",
    "version",
    "status",
    "title",
    "createdAt",
    "updatedAt",
    "provenance",
    "links",
    "payload"
  ],
  "properties": {
    "protocolVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3,}$"},
    "type": {
      "type": "string",
      "enum": [
        "requirement",
        "acceptance_criterion",
        "change_request",
        "architecture_decision",
        "architecture_element",
        "work_package",
        "implementation_evidence",
        "review_finding",
        "gap",
        "verification_evidence",
        "approval",
        "release_candidate",
        "orchestration_event",
        "baseline"
      ]
    },
    "projectId": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["actorType", "actorId", "sourceArtifactIds"],
      "properties": {
        "actorType": {"type": "string", "enum": ["human", "agent", "system", "policy"]},
        "actorId": {"type": "string", "minLength": 1},
        "sourceArtifactIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sessionId": {"type": "string"},
        "runId": {"type": "string"}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "targetId"],
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "derivedFrom", "dependsOn", "blocks", "blockedBy", "drivenBy",
              "satisfies", "satisfiedBy", "implements", "implementedBy", "conformsTo",
              "verifies", "verifiedBy", "violates", "foundIn", "affects",
              "supersedes", "supersededBy", "contains", "supportedBy", "approves", "rejects"
            ]
          },
          "targetId": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "integer", "minimum": 1}
        }
      }
    },
    "payload": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
