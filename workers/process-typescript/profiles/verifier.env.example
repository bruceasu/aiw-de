AIW_AGENT_RUNTIME=codex-app-server
# Existing system Codex CLI must be 0.162.1; no Worker-local package is installed.
AIW_PROCESS_ROLE=verifier
AIW_CONTROL_PLANE_URL=http://127.0.0.1:8080
AIW_WORKER_ID=process-verifier-1
AIW_WORKER_MAX_CONCURRENCY=1
# Add the technical capabilities required by the run, e.g. java,maven,postgresql.
AIW_WORKER_CAPABILITIES=
AIW_REPOSITORY_REF=core
AIW_REPOSITORY_ROOT=D:/03_projects/example-repo
AIW_CODEX_REASONING_EFFORT=high
AIW_WORKER_HEARTBEAT_MS=20000
AIW_CODEX_APPROVAL_POLICY=never
AIW_CODEX_NETWORK_ACCESS=false
